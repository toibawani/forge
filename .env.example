# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# Supabase (recommended for auth + Postgres + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scheduled erasure job (sent as `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=generate-a-long-random-string

# Pepper for hashing IP addresses before they are stored. Generate once and
# keep it stable, or historical rate-limit/abuse hashes stop matching.
IP_HASH_PEPPER=generate-a-long-random-string

# Email (optional). With neither provider set, sending is skipped and the app
# logs `not_configured` — it never pretends a message went out.
# Either orchestration (Knock owns templates and unsubscribe preferences):
# KNOCK_API_KEY=your-knock-secret-key
# KNOCK_SIGNING_KEY=your-knock-signing-key
# ...or direct send through Resend:
# RESEND_API_KEY=re_your_key
# EMAIL_FROM=Forge <record@your-domain.example>

# Postgres connection string, used only by the CLI (db:apply, seed, RLS tests).
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# --- Grading (Phase 1) ----------------------------------------------------
# Judge0 instance for code and SQL. Never run user code in the app process.
JUDGE0_URL=https://your-judge0-host
JUDGE0_API_KEY=

# Anthropic key for rubric grading of writing and short answers.
ANTHROPIC_API_KEY=
GRADER_MODEL=claude-sonnet-5-5

# --- Tests ----------------------------------------------------------------
# Base URL for Playwright. Leave unset to let Playwright start the app.
E2E_BASE_URL=

# Environment
NODE_ENV=development
